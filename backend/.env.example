# Smart Assignment Portal - Backend Configuration Template
# Copy this file to .env and configure your environment

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key for signing sessions and JWT tokens (change in production!)
SECRET_KEY=dev-smart-assignment-secret-key-change-in-production-123456

# Database Connection (Defaults to SQLite in backend directory)
DATABASE_URL=sqlite:///smart_assignment.db

# CORS Configuration: Whitelist frontend URLs (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Validity in Hours
JWT_EXPIRATION_HOURS=24

# Future AWS Integration Configuration (Leave empty during Phase 3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
TEXTRACT_ROLE_ARN=
